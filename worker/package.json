{
  "name": "cf-manager-worker",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public/ --d1 DB",
    "build": "node build.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "build:worker": "esbuild src/index.ts --bundle --outfile=public/_worker.js --format=esm --target=es2022 --minify",
    "deploy": "node build.js && wrangler pages deploy public/ --project-name cf-manager",
    "db:init": "wrangler d1 execute cf-manager --file=src/db/schema.sql --remote",
    "db:migrate": "node scripts/migrate.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@eslint/js": "^10.0.1",
    "adm-zip": "^0.5",
    "esbuild": "^0.25",
    "eslint": "^10.9.1",
    "javascript-obfuscator": "^5.4.3",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  }
}
